# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# All Spring Boot services load this file via:
#   spring.config.import=optional:file:../../.env[.properties]
# (paths are relative to each service module)

# ─── Auth & security ─────────────────────────────────────────────────────────
# Shared JWT secret — must match across gateway and all microservices
JWT_SECRET=your-256-bit-secret-key-here

# Google OAuth (user-auth-service login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Database ──────────────────────────────────────────────────────────────────
# Default docker-compose Postgres is localhost:5432/talentgrid.
# If port 5432 is taken, set POSTGRES_HOST_PORT=5433 below and use :5433 in DB_URL.
DB_URL=jdbc:postgresql://localhost:5432/talentgrid
DB_USERNAME=talentgrid
DB_PASSWORD=talentgrid

# Host port mapped by docker-compose (see docker-compose.yml)
POSTGRES_HOST_PORT=5432

# ─── Messaging & cache ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AI (demand-service, application-service) ──────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── CORS (API gateway only) ───────────────────────────────────────────────────
# Comma-separated origin patterns, or * for local dev
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ─── Service ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
USER_AUTH_SERVICE_PORT=8081
DEMAND_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
CANDIDATE_SERVICE_PORT=8085
APPLICATION_SERVICE_PORT=8086
INTERVIEW_SERVICE_PORT=8087
OFFER_SERVICE_PORT=8088
JOB_SERVICE_PORT=8089
AI_SERVICE_PORT=8090
WORKFORCE_SERVICE_PORT=8091

# ─── Optional overrides (defaults shown in application.properties / yml) ───────
# JWT_EXPIRATION=604800000
# JWT_REFRESH_EXPIRATION=604800000
# JWT_ISSUER=auth-service
# RATE_LIMIT_REPLENISH=30
# RATE_LIMIT_BURST=60
# RATE_LIMIT_TOKENS=1
# GATEWAY_REQUEST_LOGGING_ENABLED=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# DOCUSIGN_ENABLED=false
# OPENAI_API_KEY=
# LLM_API_KEY=
