# =============================================================================
# TalentGrid — local environment (single source of truth)
# =============================================================================
#
# Setup:
#   cp .env.example .env
#   # edit .env with your values (never commit .env)
#
# How services load this file:
#   Every Spring Boot service imports the repo-root .env via application.properties / yml:
#     spring.config.import=optional:file:../.env[.properties],optional:file:../../.env[.properties]
#
#   - Run each service from its module directory (IDE default: $MODULE_WORKING_DIR$).
#   - Do NOT create per-service .env files.
#   - Do NOT add spring-dotenv — it is not used in this project.
#
# Precedence (highest wins):
#   1. OS / IDE environment variables
#   2. This repo-root .env (via spring.config.import)
#   3. Defaults in each service's application.properties / application.yml
#
# Infrastructure (from repo root):
#   docker compose up -d    # Postgres, Redis, Kafka
#
# =============================================================================

# ─── Auth & JWT (gateway + all secured microservices) ────────────────────────
# Must be identical everywhere that validates JWTs.
JWT_SECRET=your-256-bit-secret-key-here

# Optional JWT tuning (user-auth-service)
# JWT_EXPIRATION=604800000
# JWT_REFRESH_EXPIRATION=604800000
# JWT_ISSUER=auth-service

# ─── Google OAuth (user-auth-service) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Database (all services using Postgres) ────────────────────────────────────
# Default local connection: localhost:5432 (same as docker-compose POSTGRES_HOST_PORT).
DB_HOST=localhost
POSTGRES_HOST_PORT=5432
DB_NAME=talentgrid
DB_USERNAME=talentgrid
DB_PASSWORD=talentgrid

# Optional full JDBC URL override (if set, DB_HOST/POSTGRES_HOST_PORT/DB_NAME are ignored):
# DB_URL=jdbc:postgresql://localhost:5432/talentgrid

# If local port 5432 is already in use, change only POSTGRES_HOST_PORT (and docker-compose):
#   POSTGRES_HOST_PORT=5433
#   DB_URL=jdbc:postgresql://localhost:5433/talentgrid

# ─── Messaging & cache ───────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_HOST_PORT=6379
# REDIS_PASSWORD=
# REDIS_TIMEOUT=60000

# ─── AI / Gemini ───────────────────────────────────────────────────────────────
# Google AI Studio key (typically starts with AIza...).
# demand-service: embeddings + skill suggestions
# application-service: screening / matching features
# interview-service: optional (set GEMINI_ENABLED=true to enable)
GEMINI_API_KEY=

# demand-service embedding settings (must match skills.embedding column: vector(768))
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# GEMINI_CHAT_MODEL=models/gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# application-service
# GEMINI_MODEL=gemini-2.5-flash

# interview-service
# GEMINI_ENABLED=false

# Other AI providers (optional)
# OPENAI_API_KEY=
# LLM_API_KEY=

# ─── CORS (API gateway only) ───────────────────────────────────────────────────
# Comma-separated patterns; do not use * when allow-credentials is true.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200

# ─── Service ports (local defaults) ────────────────────────────────────────────
API_GATEWAY_PORT=8080
USER_AUTH_SERVICE_PORT=8081
DEMAND_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
CANDIDATE_SERVICE_PORT=8085
APPLICATION_SERVICE_PORT=8086
INTERVIEW_SERVICE_PORT=8087
OFFER_SERVICE_PORT=8088
JOB_SERVICE_PORT=8089
AI_SERVICE_PORT=8090
WORKFORCE_SERVICE_PORT=8091

# ─── Service hosts (gateway routing; default localhost) ────────────────────────
# Override when services run in Docker/K8s with different hostnames.
# USER_AUTH_SERVICE_HOST=localhost
# DEMAND_SERVICE_HOST=localhost
# NOTIFICATION_SERVICE_HOST=localhost
# AUDIT_SERVICE_HOST=localhost
# CANDIDATE_SERVICE_HOST=localhost
# APPLICATION_SERVICE_HOST=localhost
# INTERVIEW_SERVICE_HOST=localhost
# OFFER_SERVICE_HOST=localhost
# JOB_SERVICE_HOST=localhost
# AI_SERVICE_HOST=localhost
# WORKFORCE_SERVICE_HOST=localhost

# Inter-service URLs (optional; built from HOST + PORT if unset)
# APPLICATION_SERVICE_URL=http://localhost:8086
# DEMAND_SERVICE_URL=http://localhost:8082
# CANDIDATE_SERVICE_URL=http://localhost:8085
# USER_AUTH_SERVICE_URL=http://localhost:8081

# ─── API gateway ───────────────────────────────────────────────────────────────
# GATEWAY_REQUEST_LOGGING_ENABLED=false
# GATEWAY_SHUTDOWN_TIMEOUT=30s
# GATEWAY_MAX_IN_MEMORY=10MB
# GATEWAY_HTTP_CONNECT_TIMEOUT=5000
# GATEWAY_HTTP_RESPONSE_TIMEOUT=60s
# RATE_LIMIT_REPLENISH=30
# RATE_LIMIT_BURST=60
# RATE_LIMIT_TOKENS=1
# OTEL_TRACING_EXPORT_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_TRACING_SAMPLING_PROBABILITY=1.0

# ─── Notification service (email) ─────────────────────────────────────────────
# Gmail App Password required — not your regular Gmail password.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-gmail-app-password

# ─── Offer service (DocuSign) ──────────────────────────────────────────────────
# DOCUSIGN_ENABLED=false
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# DOCUSIGN_PRIVATE_KEY_PATH=docusign/private.key
# DOCUSIGN_AUTH_SERVER=account-d.docusign.com

# ─── Candidate service (optional) ──────────────────────────────────────────────
# GCP_BUCKET_NAME=dummy-local-bucket

# ─── demand-service scheduler ──────────────────────────────────────────────────
# DEMAND_SEARCH_ACTIVATION_CRON=0 * * * * *
