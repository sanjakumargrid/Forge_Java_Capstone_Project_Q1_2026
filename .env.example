# Copy to ".env" in this directory (repo root) for docker compose variable substitution.
# Docker Compose reads ".env" automatically when you run `docker compose up`.

# If host port 5432 is already taken (e.g. local PostgreSQL), use another port:
# POSTGRES_HOST_PORT=5433
#
# Then set for Spring apps:
# DB_URL=jdbc:postgresql://localhost:5433/talentgrid

# Optional: override shared JWT signing key (must match user-auth). Default matches application.properties in both services.
# JWT_SECRET=

POSTGRES_HOST_PORT=5432
