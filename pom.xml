<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.talentgrid</groupId>
    <artifactId>talentgrid-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TalentGrid Parent</name>
    <description>Root BOM — dependency versions and build defaults for TalentGrid microservices</description>

    <modules>
        <module>talentgrid-shared</module>
        <module>talentgrid-kafka</module>
        <module>talentgrid-clients/audit-client</module>
        <module>talentgrid-clients/notification-client</module>
        <module>services/user-auth-service</module>
        <module>talentgrid-api-gateway-service</module>
        <module>services/application-service</module>
        <module>services/candidate-service</module>
        <module>services/offer-service</module>
        <module>services/interview-service</module>
        <module>services/workforce-service</module>
        <module>services/demand-service</module>
        <module>talentgrid-audit-service</module>
        <module>talentgrid-notification-service</module>
        <module>services/job-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.5.3.Final</mapstruct.version>
        <springdoc.version>2.8.9</springdoc.version>
        <springdoc.webflux.version>2.5.0</springdoc.webflux.version>
        <jjwt.version>0.12.6</jjwt.version>
        <spring-dotenv.version>4.0.0</spring-dotenv.version>
        <pgvector.version>0.1.6</pgvector.version>
        <hibernate-vector.version>6.6.49.Final</hibernate-vector.version>
        <google-cloud-storage.version>2.48.0</google-cloud-storage.version>
        <logstash-logback.version>7.4</logstash-logback.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- TalentGrid internal modules -->
            <dependency>
                <groupId>com.talentgrid</groupId>
                <artifactId>talentgrid-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.talentgrid</groupId>
                <artifactId>talentgrid-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.talentgrid</groupId>
                <artifactId>audit-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.talentgrid</groupId>
                <artifactId>notification-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.talentgrid</groupId>
                <artifactId>application-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Repo-root .env loading (paired with spring.config.import in application.properties) -->
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring-dotenv.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- API docs -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
                <version>${springdoc.webflux.version}</version>
            </dependency>

            <!-- Lombok / MapStruct -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Vector search (demand-service) -->
            <dependency>
                <groupId>com.pgvector</groupId>
                <artifactId>pgvector</artifactId>
                <version>${pgvector.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-vector</artifactId>
                <version>${hibernate-vector.version}</version>
            </dependency>

            <!-- Observability (gateway) -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>

            <!-- GCP -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>google-cloud-storage</artifactId>
                <version>${google-cloud-storage.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Repo-root .env support for all modules (runnable services use spring.config.import too) -->
    <dependencies>
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
        </dependency>

        <!-- Lombok (used by almost all modules) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing (used by almost all modules) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
