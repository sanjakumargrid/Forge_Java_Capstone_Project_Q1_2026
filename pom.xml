<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- FIX #7: 3.5.14 does not exist. Latest stable Spring Boot 3.x is 3.4.5 -->
		<version>3.4.5</version>
		<relativePath/>
	</parent>
	<groupId>com.talentgrid</groupId>
	<artifactId>talentgrid-parent</artifactId>
	<!-- FIX #2: Unified version used by all child modules -->
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>TalentGrid Parent</name>
	<description>Root BOM — dependency versions locked centrally for TalentGrid</description>

	<!-- FIX #1: Declare all child modules so Maven can build the multi-module project -->
	<modules>
		<module>talentgrid-shared</module>
		<module>talentgrid-kafka</module>
        <module>services/workforce-service</module>

        <!-- Add service modules below as they are implemented -->
		 <module>services/demand-service</module>
	</modules>

	<properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <talentgrid.version>0.0.1-SNAPSHOT</talentgrid.version>
        <org.mapstruct.version>1.5.3.Final</org.mapstruct.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>


<!--    this is dependencyManagement now child pom can use dependency from here
        with specific version they don't need to add version explicitly in child pom  -->
    <dependencyManagement>
        <dependencies>
            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${org.mapstruct.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${org.mapstruct.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
