# =============================================================================
# TalentGrid — .gitignore
# =============================================================================

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

**/application-secret.properties
**/docusign/private.key
**/google/*.json
!**/google/.gitkeep

# Google OAuth token store (interview-service)
**/google-oauth-tokens/

# ─── Maven / Java build ───────────────────────────────────────────────────────
**/target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/src/**/lib/*.jar
hs_err_pid*
replay_pid*

# ─── Logs & runtime output ─────────────────────────────────────────────────────
*.log
logs/
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/site/jacoco/

# E2E / local test reports (generated by run_*_e2e_tests.sh)
*_e2e_test_report.md
*e2e_test_report.md

# ─── Docker / local infrastructure data ──────────────────────────────────────
kafka_data/*
!kafka_data/.gitkeep

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDEs & editors ──────────────────────────────────────────────────────────
### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/

### Eclipse / STS ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# ─── Gradle (if used) ────────────────────────────────────────────────────────
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ─── Python (scripts) ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/

# ─── Node (if frontend tooling added) ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.npm

# ─── Misc ────────────────────────────────────────────────────────────────────
HELP.md
*.swp
*~
*.bak
*.tmp
